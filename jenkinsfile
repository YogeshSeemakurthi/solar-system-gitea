pipeline{
    agent any

    tools{
        nodejs 'node-24-0-2'
    }
    environment {
        MONGO_URI = "mongodb+srv://yogeshseemakurthi94:yogeshseemakurthi94@cluster0.kvbzueg.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"
    }

    stages{
        stage('check node versions'){
            steps{
                sh '''
                    node -v
                    npm -v
                    yarn --version
                '''
            }
        }
        stage('install dependencies'){
            steps{
                sh 'npm install --no-audit'
            }
        }
        stage('dependency audit'){
            parallel{
                stage('npm dependency audit'){
                    steps{
                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE'){
                            sh 'npm audit --audit-level=critical'
                        }
                    }
                }
                // stage('owasp dependency audit'){
                //     steps{
                //         catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE'){
                //             dependencyCheck additionalArguments: '''-f ALL
                //                 -o ./
                //                 --scan ./''', odcInstallation: 'owasp-dependency-check-12-1-1'
                            
                //             dependencyCheckPublisher failedTotalCritical: 1, pattern: 'dependency-check-report.xml', stopBuild: true
                //         }
                //     }
                // }
            }

        }
        stage('Unit testing'){
            steps{
                withCredentials([usernamePassword(credentialsId: 'cloudmongodbcreds', passwordVariable: 'MONGO_USERNAME', usernameVariable: 'MONGO_PASSWORD')]) {
                    sh 'npm test'
                }

            }
        }
        
    }
}