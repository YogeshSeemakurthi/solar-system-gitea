pipeline{
    agent any

    tools{
        nodejs 'node-22-6-0'
    }
    stages{
        stage('check node versions'){
            steps{
                sh '''
                    node -v
                    npm -v
                '''
            }
        }
        stage('install dependencies'){
            steps{
                sh 'npm install --no-audit'
            }
        }
        stage('npm dependency audit'){
            steps{
                sh 'npm audit --audit-level=critical'
            }
        }
    }
}